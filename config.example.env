# Copy to .env and fill in. Never commit .env.
RAW_INPUT=data/sample_postings.csv
CLEAN_OUTPUT=output/clean_postings
REPORT_DIR=output/reports

# BigQuery
GCP_PROJECT=your-gcp-project-id
BQ_DATASET=hirestream
BQ_TABLE=postings
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Snowflake (optional)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=HIRESTREAM
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_TABLE=POSTINGS
